# Copy to server/.env and fill in.

# ── Database ────────────────────────────────────────────────
# Postgres connection string (Supabase) — required
DATABASE_URL=

# ── Supabase ────────────────────────────────────────────────
# Project URL + service-role secret (JWT verification) — required
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Server ─────────────────────────────────────────────────
# HTTP port (default 3000)
PORT=3000

# Optional: workspace root override (default ~/.lean-switch/{user_id})
# WORKSPACE_ROOT=

# ── Sponsored Board (Dodo Payments) ─────────────────────────
# One-time Pay-What-You-Want product id (pdt_...) — required
DODO_PRODUCT_ID=

# Server-side API key (test-mode in dev, live-mode in prod) — required, never ship to client
DODO_PAYMENTS_API_KEY=

# test_mode | live_mode. Defaults to test_mode. Only set live_mode after
# written compliance approval from compliance@dodopayments.com.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Webhook signing secret (whsec_...) — required
DODO_PAYMENTS_WEBHOOK_KEY=

# Minimum payment in paise (default 9900 = ₹99)
BOARD_MIN_PAISE=9900

# Base URL for Dodo return_url / cancel_url (default http://localhost:5173;
# set to https://leanswitch.vercel.app in production)
CLIENT_BASE_URL=http://localhost:5173
